# ---------------------------------------------------------------
# Production Environment — terraform.tfvars.example
#
# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored; never commit real values.
# ---------------------------------------------------------------

# AWS region where production resources will be deployed.
# Must match the region used when initialising the backend.
aws_region = "us-east-1"

# Short, unique name used to prefix all resources in this environment.
# Changing this after first apply will recreate most resources.
project_name = "wordpress"

# Email address that receives billing threshold and CloudWatch alerts.
# This address will receive an SNS subscription confirmation email.
alert_email = "your-email@example.com"

# EC2 / ECS instance type for the compute module.
# For production, prefer a general-purpose or compute-optimised instance.
# Common options: t3.small, t3.medium, t3.large, m5.large
instance_type = "t3.small"

# RDS instance class for the database module.
# For production, size appropriately for expected load and enable Multi-AZ
# in the database module if high availability is required.
# Common options: db.t3.small, db.t3.medium, db.m5.large
db_instance_class = "db.t3.small"
