        "jsCode": "const text = $('Message a model').item.json.content[0].text;\n\nlet html = text\n  .replace(/### (.*)/g, '<h3>$1</h3>')\n  .replace(/## (.*)/g, '<h2>$1</h2>')\n  .replace(/# (.*)/g, '<h1>$1</h1>')\n  .replace(/\\*\\*(.*?)\\*\\*/g, '<strong>$1</strong>')\n  .replace(/\\*(.*?)\\*/g, '<em>$1</em>')\n  .replace(/`(.*?)`/g, '<code>$1</code>')\n  .replace(/\\n\\n/g, '<br><br>')\n  .replace(/\\n/g, '<br>');\n\nhtml = `<div style=\"font-family: Arial, sans-serif; max-width: 600px; padding: 20px; border: 2px solid #d32f2f; border-radius: 8px;\">${html}</div>`;\n\nreturn [{json: {html: html}}];"
